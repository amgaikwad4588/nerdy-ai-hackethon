# Copy to .env and fill in to enable the LIVE Claude-backed tutor + Supabase.
# Leave unset to run fully offline on the local mock tutor + local store (demo mode).

# Supabase project (Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Set as an Edge Function secret, NOT here (never ship the Anthropic key to the client):
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
