# Copy to .env and fill in to enable a LIVE tutor. Leave everything unset to run fully
# offline on the local mock tutor + local store (demo mode).

# --- Option A: Live tutor via Google Gemini (free key, simplest) ---------------
# Get a free key at https://aistudio.google.com/app/apikey and paste it here.
# When set, the tutor + Milo's game coaching lines are generated by Gemini.
EXPO_PUBLIC_GEMINI_API_KEY=
# Optional: override the model (default: gemini-2.0-flash)
# EXPO_PUBLIC_GEMINI_MODEL=gemini-2.0-flash

# --- Option B: Live tutor via Claude behind a Supabase Edge Function -----------
# Supabase project (Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Set as an Edge Function secret, NOT here (never ship the Anthropic key to the client):
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...

# Dispatch preference when multiple are set: Gemini -> Supabase/Claude -> local mock.

# --- Natural voice for Milo via ElevenLabs (optional, web) ---------------------
# Free key at https://elevenlabs.io. When set, Milo speaks in a natural voice on web;
# otherwise (or on any error) he falls back to the device text-to-speech.
EXPO_PUBLIC_ELEVENLABS_API_KEY=
# Optional overrides (defaults: a warm preset voice + the low-latency flash model)
# EXPO_PUBLIC_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# EXPO_PUBLIC_ELEVENLABS_MODEL=eleven_flash_v2_5
